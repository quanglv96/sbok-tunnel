# Mẫu biến môi trường của sbok-tunnel (worker). App KHÔNG tự đọc file .env (không dùng dotenv):
# đặt các biến này cho tiến trình trước khi chạy `npm start`. Không ghi giá trị thật vào file này.

# Cổng HTTP local của worker. Tuỳ chọn, mặc định 7860.
SBOK_WORKER_PORT=7860
# Token 2 chiều với sbok-service (header X-Worker-Token), phải trùng SBOK_WORKER_TOKEN bên sbok-service. Bắt buộc.
SBOK_WORKER_TOKEN=
# URL backend sbok-service để báo tiến độ/kết quả. Tuỳ chọn, mặc định https://sbok.xvibe.me/api/sbok
# Local: http://localhost:2040
SBOK_BACKEND_URL=https://sbok.xvibe.me/api/sbok

# Token Cloudflare Tunnel (cloudflared tunnel run --token). Bắt buộc để public worker.
CLOUDFLARE_TUNNEL_TOKEN=
# Đường dẫn file cloudflared. Tuỳ chọn, mặc định cloudflared (lấy từ PATH).
CLOUDFLARED_PATH=cloudflared
# Cổng metrics của cloudflared, dùng cho health check tunnel. Tuỳ chọn, mặc định 20241.
CLOUDFLARED_METRICS_PORT=20241

# Đường dẫn Python có cài VieNeu-TTS. Tuỳ chọn, mặc định python.
PYTHON_PATH=python
# Đường dẫn ffmpeg để mã hoá MP3. Tuỳ chọn, mặc định ffmpeg.
FFMPEG_PATH=ffmpeg
# Dung lượng đĩa trống tối thiểu (GB) để nhận job. Tuỳ chọn, mặc định 5.
SBOK_MIN_FREE_GB=5
# Bitrate MP3 (BR-9: 64k-128k). Tuỳ chọn, mặc định 96k.
SBOK_MP3_BITRATE=96k
# Thư mục làm việc (cache MP3, job). Tuỳ chọn, để trống = ~/.sbok-tunnel. Ví dụ: D:/sbok-work
SBOK_WORK_DIR=

# Cloudflare R2 (S3 API), cùng bucket với sbok-service. Bắt buộc để đẩy audio.
# Endpoint, ví dụ: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Tên bucket, ví dụ: sbok-audio
R2_BUCKET=
# Access key ID của R2 API token.
R2_ACCESS_KEY_ID=
# Secret access key của R2 API token.
R2_SECRET_ACCESS_KEY=
